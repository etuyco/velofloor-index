# SMTP credentials used by Nodemailer to send waitlist emails.
# Copy this file to `.env.local` and fill in real values.

SMTP_HOST=          # e.g. smtp.gmail.com / smtp.zoho.com
SMTP_PORT=587       # 465 for SSL, 587 for STARTTLS
SMTP_SECURE=false   # true if using port 465
SMTP_USER=          # SMTP login (full email address)
SMTP_PASS=          # SMTP password / app password

# "From" header for outgoing mail.
SMTP_FROM="Velofloor <no-reply@velofloor.com>"

# Comma-separated list of admins notified on each new signup.
WAITLIST_NOTIFY=admin@velofloor.com,t.edsador@velofloor.com

# --- Database (Vercel Postgres / Neon) ---
# Stores waitlist signups + unsubscribe state.
# On Vercel: connect a Postgres (Neon) store to the project and this is
# injected automatically. Locally: copy the connection string from the
# Vercel/Neon dashboard, or run `vercel env pull .env.local`.
POSTGRES_URL=

# --- Unsubscribe / compliance (CAN-SPAM, CASL) ---

# Absolute base URL of the app, used to build unsubscribe links in emails.
# Dev: http://localhost:4040  ·  Prod: https://velofloor.com
APP_BASE_URL=http://localhost:4040

# Secret used to sign (HMAC) unsubscribe tokens. Use a long random string,
# e.g. `openssl rand -base64 32`. Keep it stable so old links keep working.
UNSUBSCRIBE_SECRET=

# Sender identity + physical postal mailing address shown in every email.
# REQUIRED by CAN-SPAM and CASL — must be a valid physical address.
COMPANY_NAME="Velofloor Inc."
COMPANY_ADDRESS="123 Example St, Suite 100, Calgary, AB T2P 0A1, Canada"
